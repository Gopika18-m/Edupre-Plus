# ---- EduPre PLUS (separate project) ----
# Own port, own database name: it does NOT touch the original EduPre project.
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/edupre_plus
JWT_SECRET=change_this_to_a_long_random_secret_for_edupre_plus
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5174

# Optional: email alerts (High risk, approval requests).
# Leave SMTP_HOST empty to disable email (in-app notifications always work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduPre Plus <no-reply@edupreplus.edu>
